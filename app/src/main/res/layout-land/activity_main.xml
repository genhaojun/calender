<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingRight="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="学号:25270244"
            android:textSize="16sp"
            android:textColor="#555555"
            android:gravity="start"
            android:paddingBottom="8dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- 表达式显示 -->
        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="28sp"
            android:textColor="#000000"
            android:maxLines="2"
            android:gravity="end"
            android:layout_marginBottom="8dp"/>

        <!-- 结果显示 -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="40sp"
            android:textColor="#888888"
            android:gravity="end"/>
    </LinearLayout>

    <!-- 按钮区域 -->
    <GridLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:columnCount="4"
        android:rowCount="5"
        android:useDefaultMargins="true">

        <android.widget.Button android:id="@+id/btnC"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="C"
            android:textSize="20sp"
            android:textColor="#1976D2"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btnDiv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="÷"
            android:textSize="20sp"
            android:textColor="#1976D2"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btnMul"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="×"
            android:textSize="20sp"
            android:textColor="#1976D2"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btnDel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="⌫"
            android:textSize="20sp"
            android:textColor="#1976D2"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btn7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="7"
            android:textSize="20sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btn8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="8"
            android:textSize="20sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btn9"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="9"
            android:textSize="20sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btnSub"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="−"
            android:textSize="20sp"
            android:textColor="#1976D2"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btn4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="4"
            android:textSize="20sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btn5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="5"
            android:textSize="20sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btn6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="6"
            android:textSize="20sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="+"
            android:textSize="20sp"
            android:textColor="#1976D2"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btn1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="1"
            android:textSize="20sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btn2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="2"
            android:textSize="20sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btn3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="3"
            android:textSize="20sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btnEqual"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowSpan="2"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="="
            android:textSize="26sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_equal"/>

        <android.widget.Button android:id="@+id/btnPercent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="%"
            android:textSize="20sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btn0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="0"
            android:textSize="20sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btnDot"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="."
            android:textSize="20sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

    </GridLayout>

</LinearLayout>
