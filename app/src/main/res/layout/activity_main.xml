<?xml version="1.0" encoding="utf-8"?>
<!-- Design by 25270244 in HOHHOT,InnerMongolia-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="学号:25270244"
        android:textSize="16sp"
        android:textColor="#555555"
        android:gravity="start"
        android:paddingBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:paddingBottom="16dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="32sp"
            android:textColor="#000000"
            android:maxLines="2"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="48sp"
            android:textColor="#888888"/>
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:useDefaultMargins="true">

        <android.widget.Button android:id="@+id/btnC"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:text="C"
            android:textSize="22sp"
            android:textColor="#1976D2"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btnDiv"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:text="÷"
            android:textSize="22sp"
            android:textColor="#1976D2"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btnMul"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:text="×"
            android:textSize="22sp"
            android:textColor="#1976D2"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btnDel"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:text="⌫"
            android:textSize="22sp"
            android:textColor="#1976D2"
            android:background="@drawable/bg_btn_normal"/>

        <!-- 第二行：7  8  9  − -->
        <android.widget.Button android:id="@+id/btn7"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:text="7"
            android:textSize="22sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btn8"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:text="8"
            android:textSize="22sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btn9"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:text="9"
            android:textSize="22sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btnSub"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:text="−"
            android:textSize="22sp"
            android:textColor="#1976D2"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btn4"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:text="4"
            android:textSize="22sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btn5"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:text="5"
            android:textSize="22sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btn6"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:text="6"
            android:textSize="22sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:text="+"
            android:textSize="22sp"
            android:textColor="#1976D2"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btn1"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:text="1"
            android:textSize="22sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btn2"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:text="2"
            android:textSize="22sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btn3"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:text="3"
            android:textSize="22sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btnEqual"
            android:layout_width="0dp"
            android:layout_height="136dp"
            android:layout_rowSpan="2"
            android:layout_columnWeight="1"
            android:text="="
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_equal"/>

        <android.widget.Button android:id="@+id/btnPercent"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:text="%"
            android:textSize="22sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btn0"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:text="0"
            android:textSize="22sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

        <android.widget.Button android:id="@+id/btnDot"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:text="."
            android:textSize="22sp"
            android:textColor="#000000"
            android:background="@drawable/bg_btn_normal"/>

    </GridLayout>

</LinearLayout>
